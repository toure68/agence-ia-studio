# Utilisation locale : python start.py pour la configuration interactive.
# Déploiement Railway : définir les variables dans Railway > Variables (ne jamais committer leurs valeurs).
APP_ENV=production
DATABASE_PATH=/app/data/app.db
SESSION_SECRET=REMPLACER_PAR_UNE_VALEUR_ALEATOIRE_D_AU_MOINS_32_CARACTERES
ADMIN_EMAIL=admin@exemple.fr
ADMIN_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_UNIQUE_D_AU_MOINS_12_CARACTERES
PUBLIC_QUOTES_ENABLED=0
# OPENAI_API_KEY=      # facultatif, assistant IA et brouillons, clé côté serveur
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Sans clé serveur : la direction peut connecter une clé par entreprise dans le dialogue IA.

# Gmail OAuth (application Google Web, Gmail API activée)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://agence-ia-studio.onrender.com/api/mail/gmail/callback


# Les identifiants restent exclusivement dans les variables du serveur.
